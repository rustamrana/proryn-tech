# ─── PRORYN Web Portal — Environment Configuration ──────────────────────────
#
# Copy this file to `.env.local` and adjust values for your environment.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Base URL of the PRORYN BusinessOS application (Core Frontend).
# The "Launch App" action on /applications links here.
#
#   Local development : http://localhost:3001   (Core Frontend BusinessOS dev server)
#   Production        : set to the deployed BusinessOS URL, e.g. https://app.proryntech.com
#
# If unset in development, the portal falls back to http://localhost:3001.
# If unset in production, Launch App renders a disabled status instead of a broken link.
NEXT_PUBLIC_BUSINESSOS_URL=http://localhost:3001

# ─── Database (server-side only) ────────────────────────────────────────────
#
# MySQL connection string used by Prisma in the Contact Us API route.
# SERVER-ONLY: this is NEVER exposed to the browser. Do NOT prefix with
# NEXT_PUBLIC_ and never commit real credentials.
#
#   Local development : point at your local/hosted MySQL instance.
#   Production (Netlify): set DATABASE_URL in the Netlify environment variables
#                         UI, pointing at a remotely accessible hosted MySQL DB
#                         (localhost MySQL is NOT available in production).
#
# Format: mysql://USERNAME:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/proryn_db"

# ─── Admin session (SERVER-ONLY) ─────────────────────────────────────────────
# Secret used to sign the admin session JWT for the blog admin area (jose).
# Generate a long random value (>= 32 chars). NEVER expose to the browser and
# NEVER prefix with NEXT_PUBLIC_. Set this in Netlify env vars for production.
ADMIN_SESSION_SECRET="change-me-to-a-long-random-secret"

# Bootstrap admin user (used only by: node prisma/seed-admin.mjs)
# These are NOT read by the app at runtime — only by the one-off seed script.
ADMIN_EMAIL="admin@proryntech.com"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_NAME="PRORYN Admin"
