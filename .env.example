# ─── PRORYN Web Portal — Environment Configuration ──────────────────────────
#
# Copy this file to `.env.local` and adjust values for your environment.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Base URL of the PRORYN BusinessOS application (Core Frontend).
# The "Launch App" action on /applications links here.
#
#   Local development : http://localhost:3001   (Core Frontend BusinessOS dev server)
#   Production        : set to the deployed BusinessOS URL, e.g. https://app.proryntech.com
#
# If unset in development, the portal falls back to http://localhost:3001.
# If unset in production, Launch App renders a disabled status instead of a broken link.
NEXT_PUBLIC_BUSINESSOS_URL=http://localhost:3001
